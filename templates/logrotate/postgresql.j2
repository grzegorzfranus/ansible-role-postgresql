#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

{% if postgresql_log_directory.startswith('/') %}
{{ postgresql_log_directory }}/*.log {
{% else %}
/var/lib/postgresql/{{ __postgresql_effective_version }}/main/{{ postgresql_log_directory }}/*.log {
{% endif %}
    su {{ postgresql_logrotate_options.su | default('postgres postgres') }}
    {{ postgresql_logrotate_options.frequency | default('daily') }}
    rotate {{ postgresql_logrotate_options.rotate | default(7) }}
{% if postgresql_logrotate_options.archive_directory_path is defined and postgresql_logrotate_options.archive_directory_path | length > 0 %}
    olddir {{ postgresql_logrotate_options.archive_directory_path }}
{% endif %}
{% if postgresql_logrotate_options.dateext | default(true) %}
    dateext
{% if postgresql_logrotate_options.dateformat is defined and postgresql_logrotate_options.dateformat | length > 0 %}
    dateformat {{ postgresql_logrotate_options.dateformat }}
{% endif %}
{% endif %}
{% if postgresql_logrotate_options.compress | default(true) %}
    compress
{% endif %}
{% if postgresql_logrotate_options.delaycompress | default(true) %}
    delaycompress
{% endif %}
{% if postgresql_logrotate_options.missingok | default(true) %}
    missingok
{% endif %}
{% if postgresql_logrotate_options.notifempty | default(true) %}
    notifempty
{% endif %}
    create 0640 postgres postgres
    # Signals PostgreSQL to close and reopen log files via 'pg_ctl logrotate' (SIGHUP reload alone does not reopen logs).
    # Includes fallback to systemctl reload for older PostgreSQL versions or environments where pg_ctl logrotate is unavailable.
    postrotate
        if systemctl is-active --quiet {{ __postgresql_service_name }}; then
            su -s /bin/sh postgres -c "{{ __postgresql_bin_dir }}/pg_ctl logrotate -D {{ __postgresql_data_dir }}" > /dev/null 2>&1 || \
            systemctl reload {{ __postgresql_service_name }} > /dev/null 2>&1 || true
        fi
    endscript
}
