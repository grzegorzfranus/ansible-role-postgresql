#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

{% if postgresql_log_directory.startswith('/') %}
{{ postgresql_log_directory }}/*.log {
{% else %}
/var/lib/postgresql/{{ __postgresql_effective_version }}/main/{{ postgresql_log_directory }}/*.log /var/log/postgresql/*.log {
{% endif %}
    su {{ postgresql_logrotate_options.su | default('postgres postgres') }}
    {{ postgresql_logrotate_options.frequency | default('daily') }}
    rotate {{ postgresql_logrotate_options.rotate | default(7) }}
{% if postgresql_logrotate_options.compress | default(true) %}
    compress
{% endif %}
{% if postgresql_logrotate_options.delaycompress | default(true) %}
    delaycompress
{% endif %}
{% if postgresql_logrotate_options.missingok | default(true) %}
    missingok
{% endif %}
{% if postgresql_logrotate_options.notifempty | default(true) %}
    notifempty
{% endif %}
    create 0640 postgres postgres
    postrotate
        if systemctl is-active --quiet {{ __postgresql_service_name }}; then
            systemctl reload {{ __postgresql_service_name }} > /dev/null 2>&1 || true
        fi
    endscript
}
